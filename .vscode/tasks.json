{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start local static server",
      "type": "shell",
      "command": "if lsof -nP -iTCP:8080 -sTCP:LISTEN >/dev/null 2>&1; then echo \"Static server running at http://localhost:8080\"; else npm start; fi",
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "location": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Static server running at http://localhost:8080"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    }
  ]
}
