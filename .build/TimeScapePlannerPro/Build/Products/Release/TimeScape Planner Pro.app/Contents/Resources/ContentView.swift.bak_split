                VStack(alignment: .leading, spacing: 12) {
                    Text("Profile")
                        .font(.headline)

                    TextField("Display name", text: $displayName)

                    Toggle(
                        "Show archived buckets by default",
                        isOn: Binding(
                            get: { store.settings.prefersArchivedVisibleByDefault },
