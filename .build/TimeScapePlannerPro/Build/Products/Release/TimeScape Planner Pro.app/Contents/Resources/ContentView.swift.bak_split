    struct PlanningItemsPage: View {
        let kind: PlanningKind
        let title: String
        let eyebrow: String
        let dateFilter: PlanningDateFilter
        let domainFilter: BucketDomain?
        let bucketFilter: UUID?

        @EnvironmentObject private var store: PlannerStore

        private var filteredItems: [PlanningItem] {
            store.items(for: kind).filter { item in
                matchesDomain(item) && matchesBucket(item) && matchesDate(item)
            }
        }

        var body: some View {
            VStack(alignment: .leading, spacing: 16) {
                SectionHeader(title: title, eyebrow: eyebrow)

                if filteredItems.isEmpty {
                    Text("No items match the current filters.")
                        .font(.callout)
                        .foregroundStyle(.secondary)
                } else {
                    ForEach(filteredItems) { item in
                        PlanningItemCard(itemID: item.id)
                    }
                }
            }
        }

        private func matchesDomain(_ item: PlanningItem) -> Bool {
            guard let domainFilter else { return true }
            return item.domain == domainFilter
        }

        private func matchesBucket(_ item: PlanningItem) -> Bool {
            guard let bucketFilter else { return true }
            return item.bucketID == bucketFilter
        }

        private func matchesDate(_ item: PlanningItem) -> Bool {
            guard dateFilter != .all else { return true }
            guard let itemDate = dateForFiltering(item) else { return false }

            let calendar = Calendar.current
            switch dateFilter {
            case .all:
                return true
            case .today:
                return calendar.isDateInToday(itemDate)
            case .next7Days:
                let todayStart = calendar.startOfDay(for: Date())
                guard let upperBound = calendar.date(byAdding: .day, value: 7, to: todayStart) else { return false }
                let candidate = calendar.startOfDay(for: itemDate)
                return candidate >= todayStart && candidate <= upperBound
            }
        }

        private func dateForFiltering(_ item: PlanningItem) -> Date? {
            switch kind {
            case .event:
                return item.startDate ?? item.endDate
            case .task:
                return item.dueDate
            case .reminder:
                return item.reminderDate
            }
        }
    }

    struct PlanningItemCard: View {
        let itemID: UUID

        @EnvironmentObject private var store: PlannerStore
        @State private var editingItem: PlanningItem?

        private let maxDetailsPreviewCount = 3
        private let maxSubItemsPreviewCount = 2

        var body: some View {
            if let item = store.item(for: itemID), let bucket = store.bucket(for: item.bucketID) {
                let isDone = item.kind == .task ? item.isCompleted : item.isRead
                VStack(alignment: .leading, spacing: 10) {
                    HStack {
                        if item.kind == .task {
                            Button {
                                store.toggleTaskCompletion(itemID: item.id)
                            } label: {
                                Image(systemName: isDone ? "checkmark.circle.fill" : "circle")
                                    .font(.title3)
                                    .foregroundStyle(isDone ? .green : .secondary)
                            }
                            .buttonStyle(.plain)
                        } else if item.kind == .reminder {
                            Button {
                                store.setReminderRead(itemID: item.id, isRead: !item.isRead)
                            } label: {
                                Image(systemName: isDone ? "checkmark.circle.fill" : "circle")
                                    .font(.title3)
                                    .foregroundStyle(isDone ? .green : .secondary)
                            }
                            .buttonStyle(.plain)
                        }

                        Text(item.title)
                            .font(.headline)
                            .strikethrough(isDone)
                            .foregroundStyle(isDone ? .secondary : .primary)

                        Spacer()
                        BucketBadge(bucket: bucket)
                        Menu {
                            Button {
                                editingItem = item
                            } label: {
                                Label("Edit", systemImage: "pencil")
                            }

                            Button {
                                store.duplicateItem(itemID: item.id)
                            } label: {
                                Label("Duplicate", systemImage: "plus.square.on.square")
                            }

                            Divider()

                            Button(role: .destructive) {
                                store.deleteItem(itemID: item.id)
                            } label: {
                                Label("Delete", systemImage: "trash")
                            }
                        } label: {
                            Image(systemName: "ellipsis.circle")
                                .foregroundStyle(.secondary)
                        }
                        .menuIndicator(.hidden)
                        .menuStyle(.borderlessButton)
                    }

                    Divider()

                    sectionTitle("Core")

                    HStack(spacing: 12) {
                        Picker("Domain", selection: domainBinding(for: item.id)) {
                            ForEach(BucketDomain.allCases) { domain in
                                Label(domain.title, systemImage: domain.symbolName)
                                    .tag(domain)
                            }
                        }
                        .pickerStyle(.menu)

                        Picker("Bucket", selection: bucketBinding(for: item.id)) {
                            ForEach(store.bucketsForPicker(domain: item.domain)) { bucketOption in
                                Label(bucketOption.name, systemImage: bucketOption.icon)
                                    .tag(bucketOption.id)
                            }
                        }
                        .pickerStyle(.menu)
                    }

                    sectionTitle("Details")
                    VStack(alignment: .leading, spacing: 6) {
                        let details = detailsLines(for: item)
                        ForEach(Array(details.prefix(maxDetailsPreviewCount).enumerated()), id: \.offset) { _, line in
                            Text(line)
                                .font(.caption)
                                .foregroundStyle(.secondary)
                                .lineLimit(1)
                                .truncationMode(.tail)
                        }

                        if details.count > maxDetailsPreviewCount {
                            Text("+\(details.count - maxDetailsPreviewCount) more details")
                                .font(.caption)
                                .foregroundStyle(.secondary)
                        }
                    }

                    sectionTitle("Notes")
                    VStack(alignment: .leading, spacing: 6) {
                        if trimmedNotes(for: item).isEmpty {
                            Text("No notes")
                                .font(.caption)
                                .foregroundStyle(.secondary)
                        } else {
                            Text(trimmedNotes(for: item))
                                .font(.caption)
                                .foregroundStyle(.secondary)
                                .lineLimit(2)
                                .truncationMode(.tail)
                        }

                        if item.subItems.isEmpty {
                            Text("No sub-items")
                                .font(.caption)
                                .foregroundStyle(.secondary)
                        } else {
                            Text("\(item.subItems.filter { $0.isCompleted }.count)/\(item.subItems.count) completed")
                                .font(.caption2)
                                .foregroundStyle(.secondary)

                            ForEach(Array(item.subItems.prefix(maxSubItemsPreviewCount))) { subItem in
                                HStack(spacing: 6) {
                                    Image(systemName: subItem.isCompleted ? "checkmark.circle.fill" : "circle")
                                        .font(.caption)
                                        .foregroundStyle(subItem.isCompleted ? .green : .secondary)
                                    Text(subItem.title)
                                        .font(.caption)
                                        .foregroundStyle(subItem.isCompleted ? .secondary : .primary)
                                        .strikethrough(subItem.isCompleted)
                                        .lineLimit(1)
                                        .truncationMode(.tail)
                                }
                            }

                            if item.subItems.count > maxSubItemsPreviewCount {
                                Text("+\(item.subItems.count - maxSubItemsPreviewCount) more sub-items")
                                    .font(.caption)
                                    .foregroundStyle(.secondary)
                            }
                        }
                    }

                }
                .padding(16)
                .frame(maxWidth: .infinity, alignment: .leading)
                .background(
                    RoundedRectangle(cornerRadius: 18, style: .continuous)
                        .fill(Color(hex: bucket.colorHex).opacity(0.16))
                )
                .overlay(
                    RoundedRectangle(cornerRadius: 18, style: .continuous)
                        .stroke(Color(hex: bucket.colorHex).opacity(0.34), lineWidth: 1)
                )
                .sheet(item: $editingItem) { item in
                    PlanningItemEditorSheet(item: item) { draft in
                        store.updateItem(itemID: item.id, from: draft)
                    }
                }
            }
        }

        @ViewBuilder
        private func sectionTitle(_ title: String) -> some View {
            Text(title)
                .font(.caption.weight(.semibold))
                .foregroundStyle(.secondary)
                .textCase(.uppercase)
        }

        private func trimmedNotes(for item: PlanningItem) -> String {
            item.notes.trimmingCharacters(in: .whitespacesAndNewlines)
        }

        private func detailsLines(for item: PlanningItem) -> [String] {
            switch item.kind {
            case .event:
                var lines = [eventPreviewText(for: item)]
                if !item.location.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
                    lines.append("Location: \(item.location)")
                }
                lines.append("Repeat: \(item.repeatRule.label)")
                return lines

            case .task:
                var lines = [taskPreviewText(for: item)]
                lines.append("Priority: \(item.priority.label)")
                if let estimatedMinutes = item.estimatedMinutes {
                    lines.append("Estimate: \(estimatedMinutes) min")
                }
                lines.append("Repeat: \(item.repeatRule.label)")
                return lines

            case .reminder:
                return [
                    reminderPreviewText(for: item),
                    "Alert: \(item.reminderLeadTime.label)",
                    "Repeat: \(item.repeatRule.label)"
                ]
            }
        }

        private func domainBinding(for itemID: UUID) -> Binding<BucketDomain> {
            Binding(
                get: { store.item(for: itemID)?.domain ?? .personal },
                set: { store.updateItemDomain(itemID: itemID, domain: $0) }
            )
        }

        private func bucketBinding(for itemID: UUID) -> Binding<UUID> {
            Binding(
                get: {
                    if let item = store.item(for: itemID) {
                        return item.bucketID
                    }
                    return store.defaultBucket(for: .personal).id
                },
                set: { store.updateItemBucket(itemID: itemID, bucketID: $0) }
            )
        }

        private func eventPreviewText(for item: PlanningItem) -> String {
            let dateFormatter = DateFormatter()
            dateFormatter.dateStyle = .medium
            dateFormatter.timeStyle = .none

            let timeFormatter = DateFormatter()
            timeFormatter.dateStyle = .none
            timeFormatter.timeStyle = .short

            guard let startDate = combinedDate(date: item.startDate, time: item.startTime) else {
                return item.isAllDay ? "All day" : "No date set"
            }

            if item.isAllDay {
                return dateFormatter.string(from: startDate)
            }

            let endBaseDate = item.endDate ?? item.startDate
            if let endDate = combinedDate(date: endBaseDate, time: item.endTime) {
                return "\(dateFormatter.string(from: startDate)), \(timeFormatter.string(from: startDate)) - \(timeFormatter.string(from: endDate))"
            }

            return "\(dateFormatter.string(from: startDate)), \(timeFormatter.string(from: startDate))"
        }

        private func taskPreviewText(for item: PlanningItem) -> String {
            guard let dueDate = combinedDate(date: item.dueDate, time: item.dueTime) else {
                return "No due date set"
            }

            let dateFormatter = DateFormatter()
            dateFormatter.dateStyle = .medium
            dateFormatter.timeStyle = .none

            if item.dueTime == nil {
                return "Due \(dateFormatter.string(from: dueDate))"
            }

            let timeFormatter = DateFormatter()
            timeFormatter.dateStyle = .none
            timeFormatter.timeStyle = .short
            return "Due \(dateFormatter.string(from: dueDate)) at \(timeFormatter.string(from: dueDate))"
        }

        private func reminderPreviewText(for item: PlanningItem) -> String {
            guard let reminderDate = combinedDate(date: item.reminderDate, time: item.reminderTime) else {
                return "No reminder date set"
            }

            let dateFormatter = DateFormatter()
            dateFormatter.dateStyle = .medium
            dateFormatter.timeStyle = .none

            if item.reminderTime == nil {
                return "Reminder on \(dateFormatter.string(from: reminderDate))"
            }

            let timeFormatter = DateFormatter()
            timeFormatter.dateStyle = .none
            timeFormatter.timeStyle = .short
            return "Reminder on \(dateFormatter.string(from: reminderDate)) at \(timeFormatter.string(from: reminderDate))"
        }

        private func combinedDate(date: Date?, time: Date?) -> Date? {
            guard let date else { return nil }
            var components = Calendar.current.dateComponents([.year, .month, .day], from: date)

            if let time {
                let timeComponents = Calendar.current.dateComponents([.hour, .minute], from: time)
                components.hour = timeComponents.hour ?? 0
                components.minute = timeComponents.minute ?? 0
            }

            return Calendar.current.date(from: components)
        }

    }

